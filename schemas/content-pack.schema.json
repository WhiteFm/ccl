{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wsguild.net/ccl2/content-pack.schema.json",
  "title": "CCL2 Content Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "entities", "localizations", "assets"],
  "properties": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "packId", "namespace", "version", "rulesetId", "kind", "defaultLocale", "locales", "license", "portability"],
      "properties": {
        "schemaVersion": { "$ref": "./common.schema.json#/$defs/semver" },
        "packId": { "$ref": "./common.schema.json#/$defs/identifier" },
        "namespace": { "$ref": "./common.schema.json#/$defs/identifier" },
        "version": { "$ref": "./common.schema.json#/$defs/semver" },
        "rulesetId": { "$ref": "./common.schema.json#/$defs/identifier" },
        "kind": { "enum": ["official", "homebrew", "internal"] },
        "author": { "type": "string", "maxLength": 240 },
        "publisher": { "type": "string", "maxLength": 240 },
        "defaultLocale": { "$ref": "./common.schema.json#/$defs/locale" },
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "./common.schema.json#/$defs/locale" }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["packId", "versionRange"],
            "properties": {
              "packId": { "$ref": "./common.schema.json#/$defs/identifier" },
              "versionRange": { "type": "string", "maxLength": 80 },
              "optional": { "type": "boolean", "default": false }
            }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "attribution"],
          "properties": {
            "id": { "$ref": "./common.schema.json#/$defs/identifier" },
            "name": { "type": "string", "minLength": 1, "maxLength": 240 },
            "url": { "type": "string", "format": "uri" },
            "attribution": { "type": "string", "maxLength": 10000 }
          }
        },
        "portability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["embedTechnicalData", "embedLocalizedText", "allowDerivativePacks", "requiresEntitlement"],
          "properties": {
            "embedTechnicalData": { "type": "boolean" },
            "embedLocalizedText": { "type": "boolean" },
            "allowDerivativePacks": { "type": "boolean" },
            "requiresEntitlement": { "type": "boolean" }
          }
        },
        "createdAt": { "$ref": "./common.schema.json#/$defs/isoDateTime" },
        "publishedAt": { "$ref": "./common.schema.json#/$defs/isoDateTime" }
      }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "./content-entity.schema.json" }
    },
    "localizations": {
      "type": "object",
      "propertyNames": { "$ref": "./common.schema.json#/$defs/locale" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "$ref": "./common.schema.json#/$defs/identifier" },
        "additionalProperties": { "$ref": "./common.schema.json#/$defs/translationEntry" }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "mediaType", "sha256"],
        "properties": {
          "id": { "$ref": "./common.schema.json#/$defs/identifier" },
          "path": { "type": "string", "pattern": "^assets/[A-Za-z0-9._/-]+$" },
          "mediaType": { "type": "string", "maxLength": 120 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}

